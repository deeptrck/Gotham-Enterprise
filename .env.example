# Auth0 Regular Web Application configuration.
# Create a separate Regular Web Application for Gotham Enterprise; do not reuse
# the data-room SPA client because this Next.js app needs a client secret.
AUTH0_DOMAIN=REPLACE_WITH_AUTH0_TENANT_DOMAIN
AUTH0_CLIENT_ID=REPLACE_WITH_GOTHAM_AUTH0_REGULAR_WEB_APP_CLIENT_ID
AUTH0_CLIENT_SECRET=REPLACE_WITH_GOTHAM_AUTH0_REGULAR_WEB_APP_CLIENT_SECRET
AUTH0_SECRET=REPLACE_WITH_64_BYTE_SESSION_SECRET
APP_BASE_URL=http://localhost:3000

# Auth0 API audience used when Gotham calls protected downstream APIs.
AUTH0_AUDIENCE=https://api.deeptrack.io/gotham
AUTH0_SCOPE="openid profile email"

MONGODB_URI=
AWS_REGION=us-east-1

# Primary inference path: proprietary Gotham model hosted on AWS.
# Never expose model endpoint access or credentials to the browser.
GOTHAM_MODEL_PROVIDER=proprietary
SAGEMAKER_ENDPOINT_NAME=
SAGEMAKER_REGION=us-east-1
GOTHAM_MODEL_NAME=gotham-core
GOTHAM_MODEL_VERSION=REPLACE_WITH_APPROVED_MODEL_VERSION
GOTHAM_MODEL_TIMEOUT_MS=45000

# Temporary transition provider. Disable after proprietary-model acceptance.
REALITY_DEFENDER_API_KEY=
RD_MOCK=false
REALITY_DEFENDER_ENABLED=false

# Transitional legacy backend; empty means disabled.
BACKEND_API_URL=
NEXT_PUBLIC_API_BASE_URL=
BACKEND_REQUEST_TIMEOUT_MS=90000
