NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MONGODB_URI=
AWS_REGION=us-east-1

# Primary inference path: proprietary Gotham model hosted on AWS.
# Use either a server-side gateway URL or direct SageMaker configuration,
# according to the approved architecture decision. Never expose credentials
# or model endpoint access to the browser.
GOTHAM_MODEL_PROVIDER=proprietary
SAGEMAKER_ENDPOINT_NAME=REPLACE_WITH_PROPRIETARY_GOTHAM_ENDPOINT
SAGEMAKER_REGION=us-east-1

# Temporary transition provider. Disable after proprietary-model acceptance.
REALITY_DEFENDER_API_KEY=
RD_MOCK=false
REALITY_DEFENDER_ENABLED=false

# Transitional legacy backend; remove after canonical gateway migration.
BACKEND_API_URL=
NEXT_PUBLIC_API_BASE_URL=
BACKEND_REQUEST_TIMEOUT_MS=90000
